# robotcar Milestone 1 — copy to .env ON THE JETSON (this file is the committed template;
# .env itself is gitignored AND excluded from rsync per N2). No secrets belong here.
BRAIN_PORT=21500

# Models (pulled into ollama-new's own store)
LLM_MODEL=qwen2.5:3b            # dialogue, strong Chinese, small
VLM_MODEL=llava                 # scene description (proven on this device)
WHISPER_MODEL=small             # faster-whisper size: tiny/base/small (small = better Chinese)
WHISPER_LANG=zh                 # primary language
PIPER_VOICE=zh_CN-huayan-medium # Mandarin TTS voice

# Audio (PulseAudio host session) — verify UID/paths on device: `id -u`, `ls /run/user/<uid>/pulse`
PULSE_SOCKET=/run/user/1000/pulse/native
PULSE_COOKIE_PATH=/home/jetson/.config/pulse/cookie

# Camera
VIDEO_DEV=/dev/video0

# Interaction
LISTEN_SECONDS=5

# --- M2 voice/vision engines ---
ASR_ENGINE=sensevoice          # sensevoice(頂級,中英夾雜+情緒) | whisper(fallback)
ASR_LANG=auto
ASR_HOTWORDS=                   # comma-separated專有名詞(whisper引擎生效)
TTS_ENGINE=kokoro              # kokoro(低延遲,zh+en) | piper(fallback)
KOKORO_VOICE=zf_xiaobei        # zh female; zm_* = male
OLLAMA_KEEP_ALIVE=30s          # §C: VLM用完即卸,qwen才載得回
LLM_NUM_CTX=2048
MEM_TURNS=8
