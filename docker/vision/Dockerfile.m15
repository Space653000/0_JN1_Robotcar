FROM dustynv/l4t-ml:r36.4.0

WORKDIR /app

# 離線模式
ENV HF_HUB_OFFLINE=1
ENV TRANSFORMERS_OFFLINE=1
ENV HF_HOME=/data/hf

# 基礎工具
RUN apt-get update && apt-get install -y --no-install-recommends \
    git libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*

# 安裝依賴（包括 transformers）
RUN pip install --no-cache-dir -i https://mirrors.aliyun.com/pypi/simple/ \
    fastapi uvicorn python-multipart pillow einops accelerate opencv-python transformers 2>&1 || \
    pip install fastapi uvicorn python-multipart pillow einops accelerate opencv-python transformers

# 複製延遲加載版 server
COPY src/vision/server_lazy.py /app/server.py

# 掛載本機模型（容器內路徑：/data/hf/moondream2）
VOLUME ["/data/hf"]

EXPOSE 8000
CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000"]
